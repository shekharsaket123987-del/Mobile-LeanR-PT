# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). The anon key is
# the public, RLS-constrained key — safe in a client app, but .env itself
# is still gitignored so per-developer/per-environment values never get
# committed.
#
# This MUST point at the same Supabase project as the existing LEANR PT
# web app (LEANR_PT_MOBILE_PRD.md §4/§27) so Auth users, `profiles` rows,
# and RLS policies are shared, not duplicated.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
