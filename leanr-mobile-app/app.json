{
  "expo": {
    "name": "LEANR",
    "slug": "leanr-mobile-app",
    "version": "1.0.0",
    "description": "LEANR by Fitelo — live, online 1:1 personal training. Book sessions, train over video with your coach, and track your progress.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "leanrmobileapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F8FA",
    "ios": {
      "bundleIdentifier": "com.fitelo.leanr",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp"
        ],
        "NSCalendarsUsageDescription": "LEANR needs access to your calendar to add your session as an event."
      }
    },
    "android": {
      "package": "com.fitelo.leanr",
      "adaptiveIcon": {
        "backgroundColor": "#F4F8FA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F8FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 1
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5D90A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LEANR needs access to your photos to send images to your coach in chat.",
          "cameraPermission": "LEANR needs access to your camera to take a photo to send to your coach in chat."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "LEANR needs access to your calendar to add your session as an event."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0dbc31c9-9b60-40d0-8e83-e005712a5583"
      }
    },
    "owner": "saketkrishna123"
  }
}
