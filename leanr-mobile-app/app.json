{
  "expo": {
    "name": "LEANR",
    "slug": "leanr-mobile-app",
    "version": "1.0.0",
    "description": "LEANR by Fitelo — live, online 1:1 personal training. Book sessions, train over video with your coach, and track your progress.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "leanrmobileapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.fitelo.leanr",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["tez", "phonepe", "paytmmp"]
      }
    },
    "android": {
      "package": "com.fitelo.leanr",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 1
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5D90A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LEANR needs access to your photos to send images to your coach in chat.",
          "cameraPermission": "LEANR needs access to your camera to take a photo to send to your coach in chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
